GROQ_API_KEY=
# Yerel anlatım (Ollama, key harcatmaz): http://localhost:11434 çalışıyorsa kullanılır.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_ANLATIM=1
# Postgres kullanmak istersen doldur (boş bırakılırsa dosya hafızası kullanılır, veri kaybolmaz):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
PORT=3001
# Veri klasörü: BOŞ BIRAK — otomatik %APPDATA%\MgroqDefter\data kullanılır (proje dışın, güncellemede silinmez).
# Farklı disk/klasör istersen tam yol yaz:
# VERILER_DIZIN=D:\MgroqVeri
# --- Global SaaS / Payments (Vercel env'e aynen ekle, .env.local'a asla commit etme) ---
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_VARIANT_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# HUGGINGFACE_API_KEY=
# NEXT_PUBLIC_APP_URL=https://senin-domain.vercel.app
